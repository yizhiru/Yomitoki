{
  "name": "yomitoki",
  "version": "0.1.0",
  "description": "读解 · 日语深度阅读",
  "author": "yizhiru",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "prepare:resources": "python ../scripts/prepare_desktop.py",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "playwright test",
    "build:win": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.1.0",
    "kuromoji": "0.1.2",
    "pdfjs-dist": "6.5.438",
    "sql.js": "1.15.2"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "org.yizhiru.yomitoki",
    "productName": "读解",
    "executableName": "Yomitoki",
    "artifactName": "Yomitoki-${version}-windows-${arch}-setup.${ext}",
    "directories": {"output": "../dist/windows"},
    "files": ["src/**/*", "package.json", "!**/*.map"],
    "extraResources": [{"from": ".build/resources", "to": "reading"}],
    "asarUnpack": ["**/*.node", "node_modules/kuromoji/dict/**/*", "node_modules/sql.js/dist/*.wasm"],
    "win": {"icon": "../Resources/AppIcon.png", "target": [{"target": "nsis", "arch": ["x64"]}]},
    "nsis": {"oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "runAfterFinish": false, "deleteAppDataOnUninstall": false}
  }
}
